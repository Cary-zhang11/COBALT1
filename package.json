{
  "name": "skillflow-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const os=require('os');const ip=Object.values(os.networkInterfaces()).flat().find(i=>!i.internal&&i.family==='IPv4');console.log('  ▲ 外部访问: http://'+(ip?ip.address:'localhost')+':3000')\"",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-skills.ts",
    "db:setup": "bash scripts/setup-db.sh",
    "db:setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1"
  },
