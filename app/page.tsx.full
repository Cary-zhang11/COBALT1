"use client";

import Link from "next/link";
import { useState } from "react";
import {
  Plus, Clock, CheckCircle2, PauseCircle, XCircle,
  MoreHorizontal, Search, FileText, ArrowRight,
  Trash2, Copy, Pencil, X, AlertTriangle,
} from "lucide-react";
import { cn } from "@/lib/utils";

interface Project {
  id: string;
  name: string;
  description?: string;
  status: "created" | "running" | "paused" | "completed" | "failed" | "cancelled";
  skillName?: string;
  updatedAt: string;
  fileName?: string;
}

let nextId = 6;

const initialProjects: Project[] = [
  {
    id: "proj-1",
    name: "订单系统测试用例生成",
    description: "基于订单系统 PRD 生成完整测试用例",
    status: "completed",
    skillName: "test-cases",
    updatedAt: "2026-05-20 14:30",
    fileName: "order-system-prd.md",
  },
  {
    id: "proj-2",
    name: "支付模块 API 测试",
    description: "支付接口自动化测试代码生成",
    status: "paused",
    skillName: "test-code",
    updatedAt: "2026-05-20 11:15",
    fileName: "payment-api-spec.yaml",
  },
  {
    id: "proj-3",
    name: "用户中心 QA 检查清单",
    description: "用户中心模块 QA 检查项",
    status: "running",
    skillName: "qa-checklist",
    updatedAt: "2026-05-20 09:45",
    fileName: "user-center-requirements.docx",
  },
  {
    id: "proj-4",
    name: "购物车测试计划",
    description: "购物车功能测试计划文档",
    status: "created",
    updatedAt: "2026-05-19 18:00",
  },
  {
    id: "proj-5",
    name: "物流系统测试代码",
    description: "物流跟踪系统接口测试",
    status: "failed",
    skillName: "test-code",
    updatedAt: "2026-05-19 16:20",
    fileName: "logistics-prd.md",
  },
];

const statusConfig = {
  created: { label: "已创建", icon: FileText, color: "text-muted-foreground", bg: "bg-muted", borderColor: "border-muted-foreground/20" },
  running: { label: "执行中", icon: Clock, color: "text-cyan-600", bg: "bg-cyan-50", borderColor: "border-cyan-200" },
  paused: { label: "已暂停", icon: PauseCircle, color: "text-amber-600", bg: "bg-amber-50", borderColor: "border-amber-200" },
  completed: { label: "已完成", icon: CheckCircle2, color: "text-emerald-600", bg: "bg-emerald-50", borderColor: "border-emerald-200" },
  failed: { label: "失败", icon: XCircle, color: "text-red-600", bg: "bg-red-50", borderColor: "border-red-200" },
  cancelled: { label: "已取消", icon: XCircle, color: "text-gray-500", bg: "bg-gray-100", borderColor: "border-gray-200" },
};

export default function ProjectListPage() {
  const [projects, setProjects] = useState<Project[]>(initialProjects);
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState<string | null>(null);
  const [menuOpen, setMenuOpen] = useState<string | null>(null);

  // Delete
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [projectToDelete, setProjectToDelete] = useState<Project | null>(null);

  // Edit
  const [showEditModal, setShowEditModal] = useState(false);
  const [projectToEdit, setProjectToEdit] = useState<Project | null>(null);
  const [editName, setEditName] = useState("");
  const [editDescription, setEditDescription] = useState("");

  const filtered = projects.filter((p) => {
    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      (p.description?.toLowerCase() || "").includes(searchQuery.toLowerCase());
    const matchesStatus = statusFilter ? p.status === statusFilter : true;
    return matchesSearch && matchesStatus;
  });

  const handleDelete = (project: Project) => {
    setProjectToDelete(project);
    setShowDeleteModal(true);
    setMenuOpen(null);
  };

  const confirmDelete = () => {
    if (!projectToDelete) return;
    setProjects((prev) => prev.filter((p) => p.id !== projectToDelete.id));
    setShowDeleteModal(false);
    setProjectToDelete(null);
  };

  const handleEdit = (project: Project) => {
    setProjectToEdit(project);
    setEditName(project.name);
    setEditDescription(project.description || "");
    setShowEditModal(true);
    setMenuOpen(null);
  };

  const confirmEdit = () => {
    if (!projectToEdit) return;
    setProjects((prev) =>
      prev.map((p) =>
        p.id === projectToEdit.id
          ? { ...p, name: editName, description: editDescription, updatedAt: new Date().toLocaleString("zh-CN", { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" }).replace(/\//g, "-") }
          : p
      )
    );
    setShowEditModal(false);
    setProjectToEdit(null);
  };

  const handleCopy = (project: Project) => {
    const newProject: Project = {
      id: `proj-${nextId++}`,
      name: `${project.name} (副本)`,
      description: project.description,
      status: "created",
      skillName: undefined,
      updatedAt: new Date().toLocaleString("zh-CN", { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" }).replace(/\//g, "-"),
      fileName: project.fileName,
    };
    setProjects((prev) => [newProject, ...prev]);
    setMenuOpen(null);
  };

  return (
    <div className="flex flex-col h-full">
      <header className="px-8 py-6 border-b bg-card/50">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-bold tracking-tight">项目列表</h1>
            <p className="text-sm text-muted-foreground mt-1">
              管理您的需求处理项目，共 {projects.length} 个
              {statusFilter && (
                <span className="ml-2 text-skill-600">
                  (筛选: {statusConfig[statusFilter as keyof typeof statusConfig]?.label})
                </span>
              )}
            </p>
          </div>
          <Link
            href="/projects/new"
            className="inline-flex items-center gap-2 px-5 py-2.5 bg-skill-600 text-white rounded-lg text-sm font-medium hover:bg-skill-700 transition-colors shadow-lg shadow-skill-500/20"
          >
            <Plus className="w-4 h-4" />
            新建项目
          </Link>
        </div>

        <div className="flex items-center gap-4 mt-6">
          <div className="relative flex-1 max-w-md">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
            <input
              type="text"
              placeholder="搜索项目名称或描述..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-2.5 bg-background border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-skill-500/30 focus:border-skill-500 transition-all"
            />
            {searchQuery && (
              <button
                onClick={() => setSearchQuery("")}
                className="absolute right-3 top-1/2 -translate-y-1/2 p-0.5 rounded hover:bg-muted"
              >
                <X className="w-3.5 h-3.5 text-muted-foreground" />
              </button>
            )}
          </div>
          <div className="flex items-center gap-2">
            {Object.entries(statusConfig).map(([key, cfg]) => {
              const isActive = statusFilter === key;
              return (
                <button
                  key={key}
                  onClick={() => setStatusFilter(isActive ? null : key)}
                  className={cn(
                    "px-3 py-1.5 rounded-full text-xs font-medium transition-all border",
                    isActive
                      ? cn(cfg.bg, cfg.color, cfg.borderColor, "ring-2 ring-offset-1 ring-skill-500/30")
                      : cn("bg-background border-transparent hover:bg-muted", cfg.color)
                  )}
                >
                  {cfg.label}
                </button>
              );
            })}
          </div>
        </div>
      </header>

      <div className="flex-1 overflow-auto p-8">
        <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
          {filtered.map((project) => {
            const status = statusConfig[project.status];
            const StatusIcon = status.icon;

            return (
              <div
                key={project.id}
                className="group relative bg-card border rounded-xl p-5 hover:shadow-lg hover:shadow-skill-500/5 hover:border-skill-200 transition-all duration-300"
              >
                <div className="absolute top-4 right-4">
                  <button
                    onClick={() => setMenuOpen(menuOpen === project.id ? null : project.id)}
                    className="p-1.5 rounded-lg hover:bg-muted transition-colors opacity-0 group-hover:opacity-100"
                  >
                    <MoreHorizontal className="w-4 h-4 text-muted-foreground" />
                  </button>
                  {menuOpen === project.id && (
                    <div className="absolute right-0 top-8 w-44 bg-card border rounded-lg shadow-xl z-10 py-1">
                      <button
                        onClick={() => handleEdit(project)}
                        className="w-full px-3 py-2 text-sm text-left hover:bg-muted flex items-center gap-2"
                      >
                        <Pencil className="w-3.5 h-3.5" /> 编辑
                      </button>
                      <button
                        onClick={() => handleCopy(project)}
                        className="w-full px-3 py-2 text-sm text-left hover:bg-muted flex items-center gap-2"
                      >
                        <Copy className="w-3.5 h-3.5" /> 复制项目
                      </button>
                      <div className="border-t my-1" />
                      <button
                        onClick={() => handleDelete(project)}
                        className="w-full px-3 py-2 text-sm text-left hover:bg-muted text-red-600 flex items-center gap-2"
                      >
                        <Trash2 className="w-3.5 h-3.5" /> 删除
                      </button>
                    </div>
                  )}
                </div>

                <div className="flex items-center gap-2 mb-3">
                  <span
                    className={cn(
                      "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium",
                      status.bg,
                      status.color
                    )}
                  >
                    <StatusIcon className="w-3.5 h-3.5" />
                    {status.label}
                  </span>
                  {project.skillName && (
                    <span className="text-[10px] px-2 py-0.5 rounded-full bg-skill-50 text-skill-700 font-medium">
                      {project.skillName}
                    </span>
                  )}
                </div>

                <h3 className="font-semibold text-foreground mb-1 pr-8">
                  {project.name}
                </h3>

                {project.description && (
                  <p className="text-xs text-muted-foreground mb-2 line-clamp-2">
                    {project.description}
                  </p>
                )}

                <div className="space-y-1.5 mb-4">
                  {project.fileName && (
                    <p className="text-xs text-muted-foreground flex items-center gap-1.5">
                      <FileText className="w-3 h-3" />
                      {project.fileName}
                    </p>
                  )}
                  <p className="text-xs text-muted-foreground">
                    更新于 {project.updatedAt}
                  </p>
                </div>

                <Link
                  href={
                    project.status === "created"
                      ? `/projects/${project.id}/skills`
                      : project.status === "completed"
                      ? `/projects/${project.id}/results`
                      : `/projects/${project.id}/workflow`
                  }
                  className="inline-flex items-center gap-1.5 text-sm text-skill-600 hover:text-skill-700 font-medium group/link"
                >
                  {project.status === "created"
                    ? "选择 Skill"
                    : project.status === "completed"
                    ? "查看结果"
                    : "继续处理"}
                  <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" />
                </Link>
              </div>
            );
          })}
        </div>

        {filtered.length === 0 && (
          <div className="flex flex-col items-center justify-center py-20 text-muted-foreground">
            <FileText className="w-12 h-12 mb-4 opacity-40" />
            <p className="text-lg font-medium">
              {searchQuery || statusFilter ? "未找到匹配的项目" : "暂无项目"}
            </p>
            <p className="text-sm mt-1">
              {searchQuery || statusFilter
                ? "尝试调整搜索条件"
                : "点击"新建项目"开始您的第一个需求处理"}
            </p>
          </div>
        )}
      </div>

      {/* Delete Modal */}
      {showDeleteModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center">
          <div className="fixed inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setShowDeleteModal(false)} />
          <div className="relative z-50 bg-card border rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden">
            <div className="flex items-center justify-between px-6 py-4 border-b">
              <h2 className="text-lg font-semibold flex items-center gap-2">
                <AlertTriangle className="w-5 h-5 text-red-500" />
                确认删除
              </h2>
              <button onClick={() => setShowDeleteModal(false)} className="p-1 rounded-lg hover:bg-muted">
                <X className="w-4 h-4" />
              </button>
            </div>
            <div className="px-6 py-4">
              <p className="text-sm text-muted-foreground">
                确定要删除项目 <strong className="text-foreground">{projectToDelete?.name}</strong> 吗？
              </p>
              <p className="text-xs text-muted-foreground mt-2">
                此操作不可恢复，项目的所有历史记录和产出将被永久删除。
              </p>
            </div>
            <div className="flex items-center justify-end gap-2 px-6 py-4 border-t bg-muted/30">
              <button
                onClick={() => setShowDeleteModal(false)}
                className="px-4 py-2 border rounded-lg text-sm font-medium hover:bg-muted transition-colors"
              >
                取消
              </button>
              <button
                onClick={confirmDelete}
                className="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors flex items-center gap-1"
              >
                <Trash2 className="w-4 h-4" />
                确认删除
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Edit Modal */}
      {showEditModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center">
          <div className="fixed inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setShowEditModal(false)} />
          <div className="relative z-50 bg-card border rounded-xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden">
            <div className="flex items-center justify-between px-6 py-4 border-b">
              <h2 className="text-lg font-semibold">编辑项目</h2>
              <button onClick={() => setShowEditModal(false)} className="p-1 rounded-lg hover:bg-muted">
                <X className="w-4 h-4" />
              </button>
            </div>
            <div className="px-6 py-4 space-y-4">
              <div>
                <label className="text-sm font-medium mb-1.5 block">
                  项目名称 <span className="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  value={editName}
                  onChange={(e) => setEditName(e.target.value)}
                  className="w-full px-3 py-2.5 bg-background border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-skill-500/30 focus:border-skill-500 transition-all"
                  placeholder="输入项目名称"
                />
              </div>
              <div>
                <label className="text-sm font-medium mb-1.5 block">项目描述</label>
                <textarea
                  value={editDescription}
                  onChange={(e) => setEditDescription(e.target.value)}
                  rows={3}
                  className="w-full px-3 py-2.5 bg-background border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-skill-500/30 focus:border-skill-500 transition-all resize-none"
                  placeholder="输入项目描述（可选）"
                />
              </div>
            </div>
            <div className="flex items-center justify-end gap-2 px-6 py-4 border-t bg-muted/30">
              <button
                onClick={() => setShowEditModal(false)}
                className="px-4 py-2 border rounded-lg text-sm font-medium hover:bg-muted transition-colors"
              >
                取消
              </button>
              <button
                onClick={confirmEdit}
                disabled={!editName.trim()}
                className="px-4 py-2 bg-skill-600 text-white rounded-lg text-sm font-medium hover:bg-skill-700 transition-colors disabled:opacity-50 flex items-center gap-1"
              >
                <Pencil className="w-4 h-4" />
                保存修改
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
